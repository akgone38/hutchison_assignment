{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    
    // The strict Node ESM settings
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}