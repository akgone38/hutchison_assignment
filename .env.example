# PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For development: postgresql://user:password@localhost:5432/dogs_dev
# For QA: postgresql://user:password@qa-host.cloud/dogs_qa
# For Production: postgresql://user:password@prod-host.cloud/dogs_prod?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/dogs_dev"

# Server Port (default: 3000)
PORT=3000

# Node Environment
# development - Local machine, verbose logging, full error details
# qa         - Pre-production testing, moderate logging, error context
# production - Live server, minimal logging, generic errors (security)
NODE_ENV=development
